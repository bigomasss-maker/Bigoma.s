
package com.bigoma.s

import android.app.Activity
import android.util.Log
import okhttp3.Call
import okhttp3.Callback
import okhttp3.HttpUrl
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.Response
import org.json.JSONArray
import org.json.JSONObject
import org.maplibre.android.geometry.LatLngBounds
import java.io.IOException
import java.util.Locale

// bbox = [south, west, north, east]

data class Place(
    val name: String,
    val lat: Double,
    val lon: Double,
    val bbox: DoubleArray? = null,
    val geo: String? = null
)

class SearchController(
    private val activity: Activity,
    private val http: OkHttpClient,
    private val getBounds: () -> LatLngBounds?,
    private val onStatus: (String) -> Unit,
    private val onResults: (List<Place>) -> Unit
) {

    private var searchGeneration = 0

    private val calls = mutableListOf<Call>()

    private fun isCurrentSearch(id: Int): Boolean {
        return id == searchGeneration &&
                !activity.isFinishing &&
                !activity.isDestroyed
    }

    fun cancel() {
        searchGeneration++

        synchronized(calls) {
            calls.forEach { it.cancel() }
            calls.clear()
        }
    }

    fun search(query: String) {
        val q = query.trim()

        if (q.isEmpty()) {
            onStatus("Andika izina ry'ahantu ushaka kurondera.")
            return
        }

        val searchId = ++searchGeneration

        synchronized(calls) {
            calls.forEach { it.cancel() }
            calls.clear()
        }

        onStatus("Gushakisha: $q ...")

        searchNominatim(q) { r1, e1 ->

            if (!isCurrentSearch(searchId)) return@searchNominatim

            if (r1.isNotEmpty()) {
                onResults(r1)
            } else {

                searchPhoton(q) { r2, e2 ->

                    if (!isCurrentSearch(searchId)) {
                        return@searchPhoton
                    }

                    if (r2.isNotEmpty()) {
                        onResults(r2)
                    } else {

                        val stripped = q.replace(
                            Regex("^\\d+[A-Za-z]?\\s*,?\\s*"),
                            ""
                        )

                        if (
                            stripped != q &&
                            stripped.length > 2
                        ) {

                            searchNominatim(stripped) { r3, e3 ->

                                if (!isCurrentSearch(searchId)) {
                                    return@searchNominatim
                                }

                                if (r3.isNotEmpty()) {

                                    android.widget.Toast.makeText(
                                        activity,
                                        "Nimero y'inzu ntiyabonetse. Hano ni umuhanda.",
                                        android.widget.Toast.LENGTH_LONG
                                    ).show()

                                    onResults(r3)

                                } else {
                                    onStatus(
                                        e3 ?: "Nta hantu habonetse. Gerageza izina ry'umuhanda n'umujyi."
                                    )
                                }
                            }

                        } else {
                            onStatus(
                                e2 ?: e1
                                ?: "Nta hantu habonetse. Gerageza izina ry'umuhanda n'umujyi."
                            )
                        }
                    }
                }
            }
        }
    }

    private fun getText(
        url: HttpUrl,
        done: (String?, String?) -> Unit
    ) {

        val call = http.newCall(
            Request.Builder()
                .url(url)
                .build()
        )

        synchronized(calls) {
            calls.add(call)
        }

        call.enqueue(object : Callback {

            override fun onFailure(
                call: Call,
                e: IOException
            ) {
                synchronized(calls) {
                    calls.remove(call)
                }

                activity.runOnUiThread {
                    done(
                        null,
                        "Nta internet. Gushakisha bisaba internet."
                    )
                }
            }

            override fun onResponse(
                call: Call,
                response: Response
            ) {

                synchronized(calls) {
                    calls.remove(call)
                }

                val code = response.code

                val body = response.use {
                    if (it.isSuccessful) {
                        it.body?.string()
                    } else {
                        null
                    }
                }

                activity.runOnUiThread {
                    done(
                        body,
                        if (body == null) {
                            "Gushakisha vyanse (HTTP $code)."
                        } else {
                            null
                        }
                    )
                }
            }
        })
    }

    private fun searchNominatim(
        q: String,
        done: (List<Place>, String?) -> Unit
    ) {

        val b = HttpUrl.Builder()
            .scheme("https")
            .host("nominatim.openstreetmap.org")
            .addPathSegment("search")
            .addQueryParameter("q", q)
            .addQueryParameter("format", "json")
            .addQueryParameter("limit", "5")
            .addQueryParameter("dedupe", "0")
            .addQueryParameter("polygon_geojson", "1")
            .addQueryParameter("polygon_threshold", "0.0005")

        val bounds = getBounds()

        if (bounds != null) {

            b.addQueryParameter(
                "viewbox",
                String.format(
                    Locale.US,
                    "%.5f,%.5f,%.5f,%.5f",
                    bounds.longitudeWest,
                    bounds.latitudeNorth,
                    bounds.longitudeEast,
                    bounds.latitudeSouth
                )
            )
        }

        getText(b.build()) { body, err ->

            done(
                if (body != null) {
                    parseNominatim(body)
                } else {
                    emptyList()
                },
                err
            )
        }
    }

    private fun searchPhoton(
        q: String,
        done: (List<Place>, String?) -> Unit
    ) {

        val b = HttpUrl.Builder()
            .scheme("https")
            .host("photon.komoot.io")
            .addPathSegment("api")
            .addQueryParameter("q", q)
            .addQueryParameter("limit", "5")

        val bounds = getBounds()

        if (bounds != null) {
            val centerLat =
                (bounds.latitudeNorth + bounds.latitudeSouth) / 2.0

            val centerLon =
                (bounds.longitudeEast + bounds.longitudeWest) / 2.0

            b.addQueryParameter(
                "lat",
                String.format(Locale.US, "%.5f", centerLat)
            )

            b.addQueryParameter(
                "lon",
                String.format(Locale.US, "%.5f", centerLon)
            )
        }

        getText(b.build()) { body, err ->

            done(
                if (body != null) {
                    parsePhoton(body)
                } else {
                    emptyList()
                },
                err
            )
        }
    }

    private fun parseNominatim(
        body: String
    ): List<Place> {

        val out = ArrayList<Place>()

        try {
            val arr = JSONArray(body)

            for (i in 0 until arr.length()) {

                val o = arr.getJSONObject(i)

                var box: DoubleArray? = null

                val bb = o.optJSONArray("boundingbox")

                if (bb != null && bb.length() == 4) {

                    box = doubleArrayOf(
                        bb.getString(0).toDouble(),
                        bb.getString(2).toDouble(),
                        bb.getString(1).toDouble(),
                        bb.getString(3).toDouble()
                    )
                }

                var geo: String? = null

                val g = o.optJSONObject("geojson")

                if (g != null) {

                    val t = g.optString("type")

                    if (
                        t == "Polygon" ||
                        t == "MultiPolygon" ||
                        t == "LineString" ||
                        t == "MultiLineString"
                    ) {
                        geo = g.toString()
                    }
                }

                out.add(
                    Place(
                        o.optString("display_name", ""),
                        o.getString("lat").toDouble(),
                        o.getString("lon").toDouble(),
                        box,
                        geo
                    )
                )
            }

        } catch (ex: Exception) {

            Log.e(
                "BigomaMaps",
                "Nominatim parsing error",
                ex
            )
        }

        return out.sortedByDescending {
            val g = it.geo
            if (g != null && g.contains("Polygon")) 1 else 0
        }
    }

    private fun parsePhoton(
        body: String
    ): List<Place> {

        val out = ArrayList<Place>()

        try {

            val feats =
                JSONObject(body).getJSONArray("features")

            for (i in 0 until feats.length()) {

                val f = feats.getJSONObject(i)

                val c = f.getJSONObject("geometry")
                    .getJSONArray("coordinates")

                val props = f.getJSONObject("properties")

                var box: DoubleArray? = null

                val ex = props.optJSONArray("extent")

                if (ex != null && ex.length() == 4) {

                    box = doubleArrayOf(
                        ex.getDouble(3),
                        ex.getDouble(0),
                        ex.getDouble(1),
                        ex.getDouble(2)
                    )
                }

                out.add(
                    Place(
                        photonName(props),
                        c.getDouble(1),
                        c.getDouble(0),
                        box
                    )
                )
            }

        } catch (ex: Exception) {

            Log.e(
                "BigomaMaps",
                "Photon parsing error",
                ex
            )
        }

        return out
    }

    private fun photonName(p: JSONObject): String {

        val parts = ArrayList<String>()

        val name = p.optString("name")

        if (name.isNotEmpty()) {
            parts.add(name)
        }

        val street = p.optString("street")
        val hn = p.optString("housenumber")

        if (street.isNotEmpty()) {

            parts.add(
                if (hn.isNotEmpty()) "$hn $street"
                else street
            )
        }

        for (
            k in listOf(
                "district",
                "city",
                "state",
                "country"
            )
        ) {

            val v = p.optString(k)

            if (v.isNotEmpty() && !parts.contains(v)) {
                parts.add(v)
            }
        }

        return parts.joinToString(", ")
    }
}
